NODE_ENV=development
PORT=3002
MONGO_URL=mongodb+srv://<username>:<password>@<cluster-host>/<database>
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://singhtrades-frontend.onrender.com,https://singhtrades-dashboard.onrender.com
FRONTEND_URL=http://localhost:3001

# Optional SMS verification (Twilio Verify, no demo code is generated)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_VERIFY_SERVICE_SID=your_twilio_verify_service_sid

# Optional password reset email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
